# PostPin configuration for deploy/compose.yml. Copy to .env and fill in every value marked
# "change-me". All variables are described in docs/self-hosting.md.

# Image tag, e.g. 1.4.2. "latest" follows every release, including new major versions.
POSTPIN_VERSION=latest

# --- App -----------------------------------------------------------------------------------
# Public URL of your instance, as served by your reverse proxy
BETTER_AUTH_URL=https://postpin.example.com
# At least 32 characters: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me
# Comma-separated emails that get admin access (/admin) once verified
ADMIN_EMAILS=

# --- Legal links (optional) -----------------------------------------------------------------
# Shown in the footer, on sign-up and on share links. Leave empty to hide a link. If you run a
# public instance, you are responsible for its imprint and privacy policy, so point these at your
# own pages.
IMPRINT_URL=
PRIVACY_URL=
TERMS_URL=
# Data processing agreement (GDPR Art. 28), linked on sign-up next to the terms
DPA_URL=

# --- Database (bundled Postgres) -----------------------------------------------------------
POSTGRES_USER=postpin
# Becomes part of a connection URL, so avoid @ / : ? # and similar: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postpin

# --- Storage quotas --------------------------------------------------------------------------
# Default limits, e.g. "50 GB" or "1.5 TiB" (KB/MB/GB/TB are decimal, KiB/MiB/GiB/TiB binary).
# Leave empty for no limit. Admins can override both per organization and per user in /admin.
STORAGE_DEFAULT_ORG_QUOTA=
STORAGE_DEFAULT_USER_QUOTA=
# Total storage shown in the admin usage chart. Leave empty to show the size of the disk that
# holds ./data/s3. Set it when PostPin may only use part of that disk, ideally to the same value
# as the rustfs bucket quota (see docs/self-hosting.md).
STORAGE_CAPACITY=

# --- Storage (bundled rustfs) ----------------------------------------------------------------
# Public URL your reverse proxy serves rustfs (port 9000) on. Browsers and plugins upload and
# download media there directly.
S3_PUBLIC_ENDPOINT=https://media.example.com
# Also the rustfs admin credentials: openssl rand -hex 16 and openssl rand -hex 32
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=postpin
# Any value works with rustfs
S3_REGION=us-east-1

# --- Email (required for sign-up verification, password reset and invitations) ---------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for TLS from the start (usually port 465), false for STARTTLS
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender, e.g. "PostPin <noreply@example.com>". Falls back to SMTP_USER.
SMTP_MAIL_FROM=

# --- Ports on localhost for your reverse proxy (optional) ------------------------------------
# APP_PORT=3000
# S3_PORT=9000
