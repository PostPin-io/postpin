				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"properties": {
									"proxies": {
										"items": {
											"$ref": "#/components/schemas/UploadedProxy"
										},
										"type": "array",
										"description": "every proxy init-upload returned, after its parts were PUT"
									},
									"timelineSnapshot": {
										"$ref": "#/components/schemas/TimelineSnapshot"
									},
									"parts": {
