			"post": {
				"operationId": "CompleteUpload",
				"responses": {
					"204": {
						"description": "No content"
					},
					"404": {
						"description": "Export not found"
					},
					"409": {
						"description": "Upload missing or media already processing"
					}
				},
				"description": "Call after the file was PUT to the upload URL: checks the original exists in storage and\nqueues transcoding, probing and thumbnailing.",
				"security": [],
				"parameters": [
					{
						"in": "path",
						"name": "projectId",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "path",
						"name": "timelineId",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"in": "path",
						"name": "exportId",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
