		"title": "@postpin-io/postpin",
		"version": "0.0.1",
		"contact": {}
	},
	"paths": {
		"/v1/projects/{projectId}/timelines": {
			"post": {
				"operationId": "CreateTimeline",
				"responses": {
					"200": {
						"description": "Ok",
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"nleTimelineId": {
											"type": "string",
											"nullable": true
										},
										"updatedAt": {
											"type": "string",
											"format": "date-time"
										},
										"createdAt": {
											"type": "string",
											"format": "date-time"
										},
										"name": {
											"type": "string"
										},
										"id": {
											"type": "string"
										}
									},
									"required": ["nleTimelineId", "updatedAt", "createdAt", "name", "id"],
									"type": "object"
								}
							}
						}
					},
					"400": {
						"description": "Invalid name"
					},
					"404": {
						"description": "Project not found"
					}
				},
				"security": [
					{
						"session": []
					}
				],
				"parameters": [
