{
	"name": "@postpin-io/postpin",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n vite,tsoa,client \"vite dev\" \"pnpm run generate:api:watch\" \"pnpm run build:api-client:watch\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"build:api-client": "rm -rf ../api-client-ts/.src-tmp && npx @hey-api/openapi-ts --input src/api/build/swagger.json --output ../api-client-ts/.src-tmp && prettier --write ../api-client-ts/.src-tmp && rm -rf ../api-client-ts/src && mv ../api-client-ts/.src-tmp ../api-client-ts/src",
		"generate:api": "tsoa spec-and-routes && prettier --write src/api/build",
		"generate:api:watch": "nodemon --watch src/api --ignore src/api/build -e ts --exec \"pnpm run generate:api\"",
		"build:api-client:watch": "nodemon --watch src/api/build/swagger.json -e json --delay 1 --exec \"pnpm run build:api-client\""
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.2.7",
		"@hey-api/openapi-ts": "^0.99.0",
		"@neoconfetti/svelte": "^2.2.2",
		"@postpin-io/shared": "workspace:*",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"concurrently": "^10.0.6",
		"daisyui": "^5.7.47",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"nodemailer": "^10.0.16",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"valibot": "^1.5.0",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1149.0",
		"@aws-sdk/s3-request-presigner": "^3.1149.0",
		"@hapi/boom": "^10.0.1",
		"@hapi/hapi": "^21.4.10",
		"@hueycolor/svelte": "^1.0.1",
		"@lucide/svelte": "^1.57.0",
		"@tsoa/runtime": "7.0.0-alpha.0",
		"@videojs/hlsjs-video": "10.1.0",
		"@videojs/html": "10.1.0",
		"better-auth": "^1.7.7",
		"bullmq": "^6.3.13",
		"dotenv": "^18.0.6",
		"pg": "^8.23.1",
		"svelte-splitpanes": "^8.0.12",
		"tsoa": "7.0.0-alpha.0"
	}
}
