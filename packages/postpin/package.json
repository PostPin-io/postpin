{
	"name": "@postpin-io/postpin",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n vite,tsoa,client \"vite dev\" \"pnpm run generate:api:watch\" \"pnpm run build:api-client:watch\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"build:api-client": "sh scripts/build-api-client.sh",
		"generate:api": "tsoa spec-and-routes && prettier --write src/api/build",
		"generate:api:watch": "nodemon --watch src/api --ignore src/api/build -e ts --exec \"pnpm run generate:api\"",
		"build:api-client:watch": "nodemon --watch src/api/build/swagger.json -e json --delay 2 --exec \"pnpm run build:api-client\"",
		"test": "pnpm run test:unit && pnpm run test:integration",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage && vitest run --config vitest.integration.config.ts --coverage --coverage.reportsDirectory=coverage/integration",
		"test:unit": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1164.0",
		"@aws-sdk/s3-request-presigner": "^3.1164.0",
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.3.0",
		"@hapi/boom": "^10.0.1",
		"@hapi/hapi": "^21.4.13",
		"@hey-api/openapi-ts": "^0.99.0",
		"@hueycolor/svelte": "^1.0.1",
		"@lottiefiles/dotlottie-web": "^0.82.1",
		"@lucide/svelte": "^1.70.0",
		"@neoconfetti/svelte": "^2.2.2",
		"@postpin-io/shared": "workspace:*",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@tsoa/runtime": "7.0.0-alpha.0",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@videojs/hlsjs-video": "10.1.0",
		"@videojs/html": "10.1.0",
		"@vitest/coverage-v8": "5.1.0",
		"better-auth": "^1.7.18",
		"bullmq": "^6.7.2",
		"concurrently": "^10.0.7",
		"daisyui": "^5.7.50",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "^17.14.0",
		"ioredis": "^6.0.0",
		"mediabunny": "1.63.0",
		"nodemailer": "^10.4.0",
		"nodemon": "^3.1.14",
		"pg": "^8.23.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"qrcode": "^1.5.4",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-splitpanes": "^8.0.12",
		"tailwindcss": "^4.3.5",
		"tsoa": "7.0.0-alpha.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"valibot": "^1.5.0",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
