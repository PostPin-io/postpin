{
	"name": "@postpin-io/plugin-core",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		"./ui/*": "./src/ui/*",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
		"typecheck": "svelte-check --tsgo --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@lucide/svelte": "^1.70.0",
		"@postpin-io/api-client-ts": "workspace:*",
		"@postpin-io/shared": "workspace:*",
		"delta-e": "^0.0.8"
	},
	"peerDependencies": {
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@types/delta-e": "^0.0.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/coverage-v8": "5.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vitest": "5.1.0"
	}
}
