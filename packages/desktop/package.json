{
	"name": "@postpin-io/desktop",
	"productName": "PostPin Desktop",
	"version": "1.0.0",
	"description": "PostPin desktop app for NLEs with a local scripting API, starting with Pro Tools",
	"main": "dist/main.cjs",
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"secret:ptsl": "node scripts/upload-ptsl-secret.mjs",
		"poc": "tsx src/adapters/pro-tools/poc.ts",
		"dev:server": "vite",
		"dev:electron": "node build.mjs --dev --watch",
		"dev:app": "node scripts/dev-app.mjs",
		"dev": "concurrently --kill-others-on-fail \"pnpm run dev:server\" \"pnpm run dev:electron\" \"pnpm run dev:app\"",
		"build": "node build.mjs && vite build",
		"check": "svelte-check --tsgo --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.electron.json"
	},
	"license": "MIT",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@bufbuild/protobuf": "^2.17.0",
		"@postpin-io/api-client-ts": "workspace:*",
		"@postpin-io/plugin-core": "workspace:*",
		"@postpin-io/plugin-electron": "workspace:*",
		"@postpin-io/shared": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"concurrently": "^10.0.7",
		"daisyui": "^5.7.50",
		"electron": "^45.2.3",
		"esbuild": "^0.28.2",
		"grpc-tools": "^1.13.1",
		"long": "^5.3.2",
		"nice-grpc": "^2.1.18",
		"nice-grpc-common": "^2.0.4",
		"nodemon": "^3.1.14",
		"protobufjs": "^8.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"ts-proto": "^2.18.4",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"wait-on": "^9.5.1"
	}
}
