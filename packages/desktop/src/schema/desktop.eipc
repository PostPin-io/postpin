module PostPinDesktop

validator App = AND(
    is_main_frame is true
)

structure HostOption {
  id: string
  name: string
}

// Picks the program (NLE / DAW) the app talks to
[RendererAPI]
[ContextBridge]
[Validator=App]
interface DesktopAPI {
  listHosts() -> HostOption[]
  getSelectedHost() -> string
  // throws while an action runs on the current host
  selectHost(id: string) -> boolean
}

structure AvailableUpdate {
  version: string
  // null when the release's api-version.json couldn't be read
  apiVersion?: number
}

// Updates the app in place through electron-updater (GitHub releases)
[RendererAPI]
[ContextBridge]
[Validator=App]
interface UpdaterAPI {
  // the newest release when it's newer than this one, null otherwise or in development
  checkForUpdate() -> AvailableUpdate?
  downloadUpdate() -> boolean
  [Event]
  updateProgress(fraction: number)
  // quits and restarts into the downloaded update
  installUpdate() -> boolean
}
