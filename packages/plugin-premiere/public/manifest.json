{
	"manifestVersion": 6,
	"id": "io.postpin.plugin.premiere",
	"name": "PostPin",
	"version": "0.1.0",
	"main": "index.html",
	"host": {
		"app": "premierepro",
		"minVersion": "26.2.0"
	},
	"icons": [
		{
			"width": 24,
			"height": 24,
			"path": "icons/plugin-dark.png",
			"scale": [1, 2],
			"theme": ["darkest", "dark", "medium"],
			"species": ["pluginList"]
		},
		{
			"width": 24,
			"height": 24,
			"path": "icons/plugin-light.png",
			"scale": [1, 2],
			"theme": ["lightest", "light"],
			"species": ["pluginList"]
		}
	],
	"entrypoints": [
		{
			"type": "panel",
			"id": "postpin.panel",
			"label": {
				"default": "PostPin"
			},
			"minimumSize": {
				"width": 280,
				"height": 300
			},
			"preferredDockedSize": {
				"width": 360,
				"height": 600
			},
			"icon": [
				{
					"width": 23,
					"height": 23,
					"path": "icons/panel-dark.png",
					"scale": [1, 2],
					"theme": ["darkest", "dark", "medium"],
					"species": ["toolbar"]
				},
				{
					"width": 23,
					"height": 23,
					"path": "icons/panel-light.png",
					"scale": [1, 2],
					"theme": ["lightest", "light"],
					"species": ["toolbar"]
				}
			]
		}
	],
	"requiredPermissions": {
		"localFileSystem": "fullAccess",
		"network": {
			"domains": "all"
		},
		"launchProcess": {
			"schemes": ["http", "https"],
			"extensions": []
		},
		"webview": {
			"allow": "yes",
			"domains": "all",
			"allowLocalRendering": "yes",
			"enableMessageBridge": "localAndRemote"
		},
		"enableAddon": true
	},
	"addon": {
		"name": "postpin-process.uxpaddon"
	}
}
