{
	"name": "@postpin-io/shared",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		"./auth/*": "./src/auth/*.ts",
		"./env": "./src/env/index.ts",
		"./queue": "./src/queue/index.ts",
		"./queue/*": "./src/queue/*.ts",
		"./storage": "./src/storage/index.ts",
		"./db": "./src/db/index.ts",
		"./types/*": "./src/types/*.ts",
		"./logic/*": "./src/logic/*.ts"
	},
	"scripts": {
		"db:generate": "prisma generate --config prisma7.config.ts",
		"db:migrate": "prisma migrate dev --config prisma7.config.ts",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1149.0",
		"@aws-sdk/s3-request-presigner": "^3.1149.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bullmq": "^6.3.12",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"@types/smpte-timecode": "^1.2.5",
		"dotenv": "^18.0.6",
		"prisma": "^7.10.0",
		"smpte-timecode": "^1.3.6",
		"typescript": "^7.0.2"
	}
}
