{
	"name": "@postpin-io/shared",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		"./env": "./src/env/index.ts",
		"./queue": "./src/queue/index.ts",
		"./queue/*": "./src/queue/*.ts",
		"./media/*": "./src/media/*.ts",
		"./api-version": "./src/api-version.ts",
		"./storage": "./src/storage/index.ts",
		"./db": "./src/db/index.ts",
		"./db/enums": "./src/db/prisma/enums.ts",
		"./db/sql": "./src/db/prisma/sql.ts",
		"./types/*": "./src/types/*.ts",
		"./logic/*": "./src/logic/*.ts"
	},
	"scripts": {
		"db:generate": "prisma generate --config prisma7.config.ts --sql && prettier --write src/db/prisma",
		"db:migrate": "prisma migrate dev --config prisma7.config.ts && prettier --write src/db/prisma",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"build:migrate": "esbuild src/db/migrate-cli.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/migrate.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1164.0",
		"@aws-sdk/s3-request-presigner": "^3.1164.0",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"bullmq": "^6.7.2",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1",
		"smpte-timecode": "^1.3.6",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/smpte-timecode": "^1.2.5",
		"@vitest/coverage-v8": "5.1.0",
		"dotenv": "^18.0.9",
		"esbuild": "^0.28.2",
		"prisma": "^7.10.1",
		"typescript": "^7.0.2",
		"vitest": "5.1.0"
	}
}
