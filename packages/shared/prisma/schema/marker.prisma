model Marker {
  id String @id @default(cuid())

  name        String
  description String?

  responses Response[]

  frame Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  export   Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  exportId String
  /// NoAction: a category with markers can't be deleted (use merge first).
  /// Postgres checks this right after a cascade removes categories — NOT at the end of
  /// the outer statement. Deleting a project/org must delete markers first: see purgeExports().

  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  categoryId String
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  // id of the marker in the NLE, e.g. "<session origin id>:<memory location number>" in Pro Tools.
  // Unique per export, since every export of a timeline gets the same NLE markers.
  nleId      String?

  @@unique([exportId, nleId])
  @@index([exportId])
  @@index([categoryId])
  @@map("marker")
}

model Category {
  id String @id @default(cuid())

  name  String
  color String

  markers Marker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([projectId, name])
  @@map("category")
}

model Response {
  marker   Marker @relation(fields: [markerId], references: [id], onDelete: Cascade)
  markerId String

  id       String  @id @default(cuid())
  content  String
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([markerId])
  @@map("response")
}
