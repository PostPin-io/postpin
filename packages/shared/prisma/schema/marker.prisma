model Marker {
  id String @id @default(cuid())

  name        String
  description String?

  responses Response[]
  /// Arrows and boxes on the picture, shown while the playhead is on the marker
  pointers  MarkerPointer[]

  frame    Int
  /// length in frames, 0 = point marker
  duration Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  export   Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  exportId String
  /// NoAction: a category with markers can't be deleted (use merge first).
  /// Postgres checks this right after a cascade removes categories — NOT at the end of
  /// the outer statement. Deleting a project/org must delete markers first: see purgeExports().

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  categoryId String
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  /// Set for markers written by a share-link visitor. At most one of authorId / guestId (CHECK).
  guest      ShareGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId    String?

  // id of the marker in the NLE, e.g. "<session origin id>:<memory location number>" in Pro Tools.
  // Unique per export, since every export of a timeline gets the same NLE markers.
  nleId String?
  /// NLE timeline the marker was last synced with, so a sync can tell "deleted in the NLE" from
  /// "never synced with this timeline"
  nleTimelineId String?
  /// The plugins' hash of the marker as it was at the last sync, the common base to tell which side
  /// changed it since (see plugin-core's syncHash.ts). Opaque to the server.
  syncHash String?

  @@unique([exportId, nleId])
  @@index([guestId])
  @@index([exportId])
  @@index([categoryId])
  @@map("marker")
}

enum PointerKind {
  ARROW
  RECT
}

/// A visual hint on the video picture that belongs to a marker.
/// Coordinates are fractions (0..1) of the picture, so they don't depend on player size or rendition.
model MarkerPointer {
  id String @id @default(cuid())

  marker   Marker      @relation(fields: [markerId], references: [id], onDelete: Cascade)
  markerId String
  /// Fixed after creation: changing it means deleting the pointer and drawing a new one
  kind     PointerKind
  /// ARROW: the tip. RECT: the top-left corner.
  x        Float
  y        Float
  /// RECT only (CHECK)
  width    Float?
  height   Float?
  /// One of POINTER_COLORS (shared/logic/pointers.ts)
  color    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([markerId])
  @@map("marker_pointer")
}

model Category {
  id String @id @default(cuid())

  name  String
  color String

  markers Marker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project  @relation("ProjectCategories", fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  /// Share links whose guests' markers land here
  shareLinks ShareLink[]

  @@unique([projectId, name])
  @@map("category")
}

/// A reusable set of categories of an organization, saved from a project's categories. Outlives
/// the project. The built-in presets live in code (shared/src/logic/category-presets.ts).
model CategoryPreset {
  id String @id @default(cuid())

  name String
  /// [{ name, color }], a copy: later changes to the project's categories don't reach the preset
  categories Json

  createdAt DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@unique([organizationId, name])
  @@map("category_preset")
}

model Response {
  marker   Marker @relation(fields: [markerId], references: [id], onDelete: Cascade)
  markerId String

  id       String  @id @default(cuid())
  content  String
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([markerId])
  @@map("response")
}

/// What's left of a marker deleted in PostPin, so the plugins neither push it back nor keep it in
/// the NLE (they offer to remove it there)
model DeletedMarker {
  /// the deleted marker's id
  markerId String @id

  export   Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  exportId String

  nleId         String?
  nleTimelineId String?
  syncHash      String?

  deletedAt DateTime @default(now())

  @@index([exportId])
  @@map("deleted_marker")
}

enum MarkerSetAction {
  PUSH
  PULL
  CLEAR
  RESTORE
}

/// A backup of the markers taken before a plugin action (push, pull, delete all, restore), so the
/// action can be undone. Holds both sides as they were before it: the NLE's markers and the
/// export's. Never changes after creation.
model MarkerSet {
  id String @id @default(cuid())

  action MarkerSetAction

  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  timelineId String
  /// the export the action worked on; null for delete all without one, or when it was deleted
  export     Export?  @relation(fields: [exportId], references: [id], onDelete: SetNull)
  exportId   String?

  /// the NLE timeline the action ran in, and its host ("Resolve", "Pro Tools")
  nleTimelineId   String
  nleTimelineName String?
  hostName        String

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())

  /// what the action changed, for the history list: { added, updated, removed } per side
  summary        Json
  /// NleMarkerSnapshot, see shared/src/logic/marker-sets.ts
  nleMarkers     Json
  /// PostPinMarkerSnapshot (with responses and pointers); null without an export
  postpinMarkers Json?

  @@index([timelineId, nleTimelineId, createdAt])
  @@index([exportId])
  @@index([createdById])
  @@map("marker_set")
}
