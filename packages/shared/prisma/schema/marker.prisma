model Marker {
  id String @id @default(cuid())

  name        String
  description String?

  responses Response[]

  frame    Int
  /// length in frames, 0 = point marker
  duration Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  export   Export @relation(fields: [exportId], references: [id], onDelete: Cascade)
  exportId String
  /// NoAction: a category with markers can't be deleted (use merge first).
  /// Postgres checks this right after a cascade removes categories — NOT at the end of
  /// the outer statement. Deleting a project/org must delete markers first: see purgeExports().

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  categoryId String
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId   String?
  /// Set for markers written by a share-link visitor. At most one of authorId / guestId (CHECK).
  guest      ShareGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestId    String?

  // id of the marker in the NLE, e.g. "<session origin id>:<memory location number>" in Pro Tools.
  // Unique per export, since every export of a timeline gets the same NLE markers.
  nleId String?

  @@unique([exportId, nleId])
  @@index([guestId])
  @@index([exportId])
  @@index([categoryId])
  @@map("marker")
}

model Category {
  id String @id @default(cuid())

  name  String
  color String

  markers Marker[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project  @relation("ProjectCategories", fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String
  /// Back side of Project.guestCategory; set iff this is the project's guest category
  guestOfProject Project? @relation("ProjectGuestCategory")

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  /// Screening links whose guests' markers land here
  shareLinks ShareLink[]

  @@unique([projectId, name])
  @@map("category")
}

model Response {
  marker   Marker @relation(fields: [markerId], references: [id], onDelete: Cascade)
  markerId String

  id       String  @id @default(cuid())
  content  String
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([markerId])
  @@map("response")
}
