model Media {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  status     MediaStatus @default(PENDING)
  original   MediaFile   @relation("MediaOriginal", fields: [originalId], references: [id], onDelete: Cascade)
  originalId String      @unique
  proxies    MediaFile[] @relation("MediaProxies")
  thumbnail  Thumbnail?
  export     Export?

  @@map("media")
}

model MediaFile {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      MediaStatus @default(PENDING)
  originalOf  Media?      @relation("MediaOriginal")
  proxyOf     Media?      @relation("MediaProxies", fields: [proxyOfId], references: [id], onDelete: Cascade)
  proxyOfId   String?
  contentType String?
  size        BigInt?
  /// seconds
  duration    Float?
  bitrate     Int?

  videoCodec String?
  width      Int?
  height     Int?
  frameRate  Float?

  audioCodec String?
  sampleRate Int?
  channels   Int?

  @@unique([proxyOfId, width, height, bitrate])
  @@map("media_file")
}

model Thumbnail {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      MediaStatus @default(PENDING)
  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId     String      @unique
  contentType String
  frame       Int

  @@map("thumbnail")
}

enum MediaStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
