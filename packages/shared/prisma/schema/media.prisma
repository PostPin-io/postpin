model Media {
  id                       String      @id @default(cuid())
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  status                   MediaStatus @default(PENDING)
  /// Unfinished uploads: their original's size counts against the quotas until then. Renewed
  /// by init-upload and resume-upload, as long as the part URLs they hand out are valid
  reservedUntil            DateTime?
  original                 MediaFile   @relation("MediaOriginal", fields: [originalId], references: [id], onDelete: Cascade)
  originalId               String      @unique
  proxies                  MediaFile[] @relation("MediaProxies")
  thumbnail                Thumbnail?
  export                   Export?
  seekSprites              Json?
  shotThumbnails           Json?
  /// The newest requested render of the shot thumbnails; only its job may publish, see ShotThumbnails
  shotThumbnailsGeneration String?
  movieBarcode             Json?
  /// Web uploads: picture changes the cut detection found, see SceneScores
  sceneScores              Json?
  // bytes of the generated images in the bucket, measured once processing ends
  thumbnailSize            BigInt?
  seekSpritesSize          BigInt?
  shotThumbnailsSize       BigInt?

  @@map("media")
}

model MediaFile {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      MediaStatus @default(PENDING)
  originalOf  Media?      @relation("MediaOriginal")
  proxyOf     Media?      @relation("MediaProxies", fields: [proxyOfId], references: [id], onDelete: Cascade)
  proxyOfId   String?
  contentType String?
  size        BigInt?
  /// seconds
  duration    Float?
  bitrate     Int?

  videoCodec String?
  width      Int?
  height     Int?
  frameRate  Float?
  /// RFC 6381, e.g. "avc1.64002a,mp4a.40.2"
  codecs     String?
  hls        Json?

  audioCodec String?
  sampleRate Int?
  channels   Int?

  @@unique([proxyOfId, width, height, bitrate])
  @@map("media_file")
}

model Thumbnail {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      MediaStatus @default(PENDING)
  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId     String      @unique
  contentType String
  frame       Int

  @@map("thumbnail")
}

enum MediaStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
