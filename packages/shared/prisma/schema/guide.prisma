/// PostPin Guides (tutorials and tours, see docs/guides/): one row per user and guide once it was
/// started. No row = never started, so the guide may start on its own.
model GuideProgress {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The id from docs/guides/ (e.g. "first-upload"); never renamed once released
  guideId   String
  status    GuideStatus
  /// Where a started guide goes on after a reload
  step      String?
  /// What the guide made on the way (e.g. the tutorial's project), to pick up from there
  context   Json?

  @@unique([userId, guideId])
  @@map("guide_progress")
}

enum GuideStatus {
  STARTED
  COMPLETED
  SKIPPED
}
