model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  inviteLinks InviteLink[]
  sessions    Session[]
  projects    Project[]

  lastActiveUsers User[] @relation("LastActiveOrganization")

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role
  createdAt      DateTime

  memberGrants MemberGrant[]

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  REVIEWER
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviter        User?        @relation(fields: [inviterId], references: [id], onDelete: SetNull)
  inviterId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String?
  timeline       Timeline?    @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  timelineId     String?

  @@index([organizationId])
  @@index([email])
  @@index([projectId])
  @@index([timelineId])
  @@map("invitation")
}

model InviteLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  token          String       @unique
  enabled        Boolean      @default(true)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId      String?
  timeline       Timeline?    @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  timelineId     String?

  @@unique([organizationId, role, projectId, timelineId])
  @@map("invite_link")
}

model MemberGrant {
  id String @id @default(cuid())

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId String

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?

  timeline   Timeline? @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  timelineId String?

  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  createdAt DateTime @default(now())

  @@unique([memberId, projectId])
  @@unique([memberId, timelineId])
  @@index([projectId])
  @@index([timelineId])
  @@map("member_grant")
}
