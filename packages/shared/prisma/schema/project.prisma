model Project {
  id              String       @id @default(cuid())
  name            String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  creator         User?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId       String?
  timelines       Timeline[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  categories      Category[]   @relation("ProjectCategories")
  /// Category for share-link visitor markers, created on first use (ensureGuestCategory)
  guestCategory   Category?    @relation("ProjectGuestCategory", fields: [guestCategoryId], references: [id], onDelete: SetNull)
  guestCategoryId String?      @unique

  nleProjectId String?
  memberGrants MemberGrant[]

  inviteLinks InviteLink[]
  invitations Invitation[]

  @@unique([organizationId, nleProjectId])
  @@index([creatorId])
  @@map("project")
}

model Timeline {
  id            String        @id @default(cuid())
  name          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  exports       Export[]
  nleTimelineId String?
  memberGrants  MemberGrant[]
  invitations   Invitation[]
  inviteLinks   InviteLink[]

  @@index([projectId])
  @@map("timeline")
}

model Export {
  id                   String      @id @default(cuid())
  name                 String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  timeline             Timeline    @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  timelineId           String
  media                Media?      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId              String?     @unique
  timelineSnapshot     Json?
  timelineSnapshotHash String?
  /// Web uploads: the tracks of the editing software's timeline (from an EDL or FCPXML), uploaded
  /// with the video into the media's bucket folder; they become the snapshot's tracks once the
  /// worker knows the frame rate. See cut-list.ts
  cutListKey           String?
  /// Why the worker couldn't use the cut list; the cuts are estimated then
  cutListError         String?
  markers              Marker[]
  shareLinks           ShareLink[]
  uploadedBy           User?       @relation("ExportUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById         String?

  @@index([uploadedById])
  @@index([timelineId])
  @@map("export")
}

model ShareLink {
  id                   String          @id @default(cuid())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  export               Export          @relation(fields: [exportId], references: [id], onDelete: Cascade)
  exportId             String
  creator              User?           @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  creatorId            String?
  /// Random, URL-safe. Not the id: cuids are guessable-ish and can't be rotated.
  token                String          @unique
  expiresAt            DateTime
  /// Set instead of deleting, so the list stays traceable
  revokedAt            DateTime?
  timelinePanelVisible Boolean         @default(false)
  markerPanelVisible   Boolean         @default(true)
  /// Plain text, length checked in the app (NOTE_MAX_LENGTH)
  note                 String?
  guests               ShareGuest[]
  mails                ShareLinkMail[]
  /// Visits by guests: a reload within 30 minutes counts as the same visit (recordShareView)
  viewCount            Int             @default(0)
  lastViewedAt         DateTime?

  @@index([exportId])
  @@map("share_link")
}

/// A visitor who opened a share link and entered a name. One per browser (cookie).
model ShareGuest {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())
  shareLink        ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  shareLinkId      String
  name             String?
  /// sha256 of the cookie value; the raw token never touches the DB
  sessionTokenHash String    @unique
  lastViewedAt     DateTime?

  markers Marker[]

  @@index([shareLinkId])
  @@map("share_guest")
}

/// One "send by e-mail" of a share link. Counts toward the sender's daily limit per link.
model ShareLinkMail {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  shareLinkId String
  sender      User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderId    String?
  recipients  String[]

  @@index([shareLinkId, senderId, createdAt])
  @@map("share_link_mail")
}
