module PostPinResolveAPI

validator MyApp = AND(
    is_main_frame is true
)

structure Settings {
  renderToDisk: boolean
  outputPath: string
  filename: string
}

structure RenderProgress {
  percent: number
  estimatedTimeRemainingMs: number
}

structure UploadPartUrl {
  partNumber: number
  url: string
}

structure UploadedPart {
  partNumber: number
  etag: string
}

structure UploadProgress {
  uploadedBytes: number
  totalBytes: number
}

structure Marker {
  title: string
  description: string
  frame: number
  color: MarkerColor
  customData: string
}

enum  MarkerColor {
	Blue
	Cyan
	Green
	Yellow
	Red
	Pink
	Purple
	Fuchsia
	Rose
	Lavender
	Sky
	Mint
	Lemon
	Sand
	Cocoa
	Cream
}

structure LoginConfig {
  serverBaseUrl: string
}

structure LoginCode {
  userCode: string
  verificationUri: string
}

[RendererAPI]
[ContextBridge]
[Validator=MyApp]
interface MainAPI {
  getRenderPresets() -> string[]
  renderPreview(targetDirPath: string, targetClipName: string) -> string
  [Event]
  renderProgress(progress: RenderProgress)
  getFileSize(path: string) -> number
  uploadRenderedFile(sourcePath: string, partSize: number, parts: UploadPartUrl[]) -> UploadedPart[]
  [Event]
  uploadProgress(progress: UploadProgress)
  openInBrowser(path: string) -> boolean
  buildTimelineSnapshot() -> unknown
  getLastSettings() -> Settings
  saveSettings(settings: Settings) -> boolean
  pickOutputDirectory() -> string
  getMarkers() -> Marker[]
  setMarkers(markers: Marker[]) -> boolean
  setMarker(marker: Marker) -> boolean
  clearMarkers() -> boolean
  deleteMarker(frame: number) -> boolean
  getTimelineStartFrame() -> number
  test() -> boolean
  getProjectId() -> string
  getTimelineId() -> string

  // Auth
  getSession() -> unknown
  getSessionToken() -> string
  logout() -> boolean
  login(config: LoginConfig) -> boolean
  [Event]
  loginCode(code: LoginCode)
  [Event]
  sessionChanged(session: unknown)
}