{
	"name": "@postpin-io/resolve-plugin",
	"version": "1.0.0",
	"description": "PostPin workflow integration plugin for DaVinci Resolve",
	"main": "main.js",
	"scripts": {
		"setup:mac": "P=\"/Library/Application Support/Blackmagic Design/DaVinci Resolve/Workflow Integration Plugins/com.postpin.resolve\" && sudo rm -rf \"$P\" && sudo mkdir -p \"$P\" && sudo chown \"$USER\" \"$P\"",
		"build": "node build.mjs && vite build",
		"install:mac": "P=\"/Library/Application Support/Blackmagic Design/DaVinci Resolve/Workflow Integration Plugins/com.postpin.resolve\" && pnpm run build && rm -rf \"$P\"/* && cp -R dist/. \"$P\"",
		"dev:server": "vite",
		"dev:electron": "node build.mjs --dev --watch --install",
		"dev": "concurrently --kill-others-on-fail \"pnpm run dev:electron\" \"pnpm run dev:server\"",
		"preview": "vite preview",
		"check": "svelte-check --tsgo --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.electron.json",
		"generate:resolve": "python3 scripts/generate-resolve-types.py && prettier --write src/electron/resolve.ts"
	},
	"devDependencies": {
		"@postpin-io/api-client-ts": "workspace:*",
		"@postpin-io/plugin-core": "workspace:*",
		"@postpin-io/plugin-electron": "workspace:*",
		"@postpin-io/shared": "workspace:*",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@7",
		"concurrently": "^10.0.6",
		"daisyui": "^5.7.47",
		"electron": "~36.3.2",
		"esbuild": "^0.28.2",
		"nodemon": "^3.1.14",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"type": "module",
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3"
	}
}
