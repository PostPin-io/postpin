module PostPin

validator App = AND(
    is_main_frame is true
)

structure PaletteColor {
  id: string
  hex: string
  name?: string
}

structure Capabilities {
  hostName: string
  palette: PaletteColor[]
  anyColor: boolean
  renderPresets: boolean
  renderToDisk: boolean
  snapshotClips: boolean
  customMarkerData: boolean
}

structure NleMarker {
  nleId?: string
  title: string
  description: string
  frame: number
  color: string
  customData?: string
}

structure RenderProgress {
  percent: number
  estimatedTimeRemainingMs: number
}

structure UploadPartUrl {
  partNumber: number
  url: string
}

structure UploadedPart {
  partNumber: number
  etag: string
}

structure UploadProgress {
  uploadedBytes: number
  totalBytes: number
}

structure Settings {
  renderToDisk: boolean
  outputPath: string
  filename: string
}

structure LoginConfig {
  serverBaseUrl: string
}

structure LoginCode {
  userCode: string
  verificationUri: string
}

structure ProbedMedia {
  width: number
  height: number
  rotation?: number
  hasAudio: boolean
  duration?: number
}

structure Rendition {
  width: number
  height: number
  bitRate: number
}

structure HlsRange {
  offset: number
  length: number
}

structure HlsSegment {
  duration: number
  offset: number
  length: number
}

structure HlsInfo {
  init: HlsRange
  segments: HlsSegment[]
}

structure EncodedProxy {
  path: string
  hls: HlsInfo
  bytes: number
}

[RendererAPI]
[ContextBridge]
[Validator=App]
interface CommonAPI {
  getServerUrl() -> string
  getDefaultServerUrl() -> string
  getSession() -> unknown
  getToken() -> string?
  login(config: LoginConfig) -> boolean
  logout() -> boolean
  [Event]
  loginCode(code: LoginCode)
  [Event]
  sessionChanged(session: unknown)
  getSettings() -> Settings
  saveSettings(settings: Settings) -> boolean
  getFileSize(path: string) -> number
  uploadFile(path: string, partSize: number, parts: UploadPartUrl[]) -> UploadedPart[]
  [Event]
  uploadProgress(progress: UploadProgress)
  openInBrowser(path: string) -> boolean
  pickDirectory() -> string
  // progress bar on the dock / taskbar icon, 0 to 1, negative removes it
  setProgress(fraction: number) -> boolean

  // false when this host has no ffmpeg; then the other three throw
  canTranscode() -> boolean
  probe(path: string) -> ProbedMedia
  transcode(input: string, renditions: Rendition[], hasAudio: boolean) -> EncodedProxy[]
  [Event]
  transcodeProgress(fraction: number)
  removeFile(path: string) -> boolean
}

structure TimelineInfo {
  name: string
  id: string
  projectId: string
  projectName: string
  thumbnailDataUrl?: string
}

[RendererAPI]
[ContextBridge]
[Validator=App]
interface NleAPI {
  getCapabilities() -> Capabilities
  getProjectId() -> string
  getTimelineInfo() -> TimelineInfo?
  getMarkers() -> NleMarker[]
  setMarkers(markers: NleMarker[]) -> string[]
  clearMarkers() -> boolean
  getRenderPresets() -> string[]
  renderPreview() -> string
  [Event]
  renderProgress(progress: RenderProgress)
  buildTimelineSnapshot() -> unknown
}
