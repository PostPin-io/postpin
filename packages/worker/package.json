		"@postpin/shared": "workspace:*",
		"bullmq": "^6.3.12",
		"ioredis": "^6.0.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"main": "dist/index.js"
}
