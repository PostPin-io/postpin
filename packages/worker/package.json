{
	"name": "@postpin-io/worker",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node26 --sourcemap --outfile=dist/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
		"start": "node --enable-source-maps dist/index.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@aws-sdk/lib-storage": "^3.1164.0",
		"@postpin-io/shared": "workspace:*",
		"bullmq": "^6.7.2",
		"ioredis": "^6.0.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "5.1.0"
	},
	"main": "dist/index.js"
}
