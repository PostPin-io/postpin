{
	"name": "@postpin/worker",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
