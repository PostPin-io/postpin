<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<!-- PROTOTYPE: terminology for the FCP custom share destination, after Apple's SimpleAssetManagerSample.
     The access groups let the sandboxed Final Cut Pro send these events to us. The events themselves are
     answered by raw handlers in ShareDestination.swift, not by Cocoa Scripting. -->
<dictionary xmlns:xi="http://www.w3.org/2003/XInclude">
	<xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite)"/>
	<suite name="ProVideo Asset Management" code="pvam" description="Pro Video Asset Management">
		<record-type name="asset location" code="aslc">
			<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
			<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			<property name="folder" code="asfd" type="file"/>
			<property name="base name" code="asbn" type="text"/>
			<property name="has media" code="ashm" type="boolean"/>
			<property name="has description" code="ashd" type="boolean"/>
		</record-type>
		<record-type name="library location" code="lblc">
			<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
			<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			<property name="library folder" code="lbfd" type="file"/>
			<property name="library base name" code="lbbn" type="text"/>
			<property name="has archive" code="lbha" type="boolean"/>
			<property name="has library description" code="lbhd" type="boolean"/>
		</record-type>
		<value-type name="user defined record" code="usrf">
			<cocoa class="NSDictionary"/>
		</value-type>
		<command name="open" code="aevtodoc" description="Open exported files.">
			<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
			<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			<direct-parameter>
				<type type="file"/>
				<type type="file" list="yes"/>
			</direct-parameter>
			<result type="specifier"/>
		</command>
		<command name="make" code="corecrel" description="Create a new asset.">
			<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
			<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			<parameter name="new" code="kocl" type="type"/>
			<parameter name="at" code="insh" type="location specifier" optional="yes"/>
			<parameter name="with data" code="data" type="any" optional="yes"/>
			<parameter name="with properties" code="prdt" type="record" optional="yes"/>
			<result type="specifier"/>
		</command>
		<command name="get" code="coregetd" description="Get a property.">
			<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
			<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			<direct-parameter type="specifier"/>
			<result type="any"/>
		</command>
		<class-extension extends="application">
			<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
			<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			<element type="asset">
				<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
				<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
				<cocoa key="scriptingAssets"/>
			</element>
		</class-extension>
		<class name="asset" code="aset" description="A media asset.">
			<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
			<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			<cocoa class="NSObject"/>
			<property name="id" code="ID  " type="text" access="r">
				<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
				<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			</property>
			<property name="name" code="pnam" type="text" access="r">
				<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
				<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			</property>
			<property name="location info" code="locn" type="asset location" access="r">
				<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
				<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			</property>
			<property name="library info" code="lbry" type="library location" access="r">
				<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
				<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			</property>
			<property name="metadata" code="meta" type="user defined record" access="rw">
				<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
				<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			</property>
			<property name="data options" code="dopt" type="user defined record" access="rw">
				<access-group identifier="com.apple.proapps.assetmanagement.import" access="rw"/>
				<access-group identifier="com.apple.assetmanagement.import" access="rw"/>
			</property>
		</class>
	</suite>
</dictionary>
