# Postgres (used by docker-compose.yml)
POSTGRES_USER=postpin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postpin

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173

# Prisma
DATABASE_URL="postgresql://postpin:change-me@localhost:5439/postpin?schema=public"

# SMTP (defaults point at the maildev container, web UI at http://localhost:1080)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. "Postpin <noreply@postpin.io>". Falls back to SMTP_USER.
SMTP_MAIL_FROM="Postpin <noreply@localhost>"

# S3
# Leave S3_ENDPOINT empty to use AWS S3; set it for S3-compatible servers (rustfs container locally).
S3_ENDPOINT=http://localhost:9003
# Path-style URLs (endpoint/bucket/key) are needed for most self-hosted S3 servers.
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=postpin
S3_REGION="eu-west-1"

# Redis (used by docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_USE_SSL=false
