# Postgres (used by docker-compose.yml)
POSTGRES_USER=postpin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postpin

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:5173

# Prisma
DATABASE_URL="postgresql://postpin:change-me@localhost:5439/postpin?schema=public"

# Admin
# Comma-separated, verified emails that can open /admin
ADMIN_EMAILS="admin@localhost,user@test.invalid"

# SMTP (defaults point at the maildev container, web UI at http://localhost:1080)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. "Postpin <noreply@postpin.io>". Falls back to SMTP_USER.
SMTP_MAIL_FROM="Postpin <noreply@localhost>"

# S3
# Leave S3_ENDPOINT empty to use AWS S3; set it for S3-compatible servers (rustfs container locally).
S3_ENDPOINT=http://localhost:9003
# Public S3 URL that browsers and plugins can reach, used in presigned URLs.
# Leave empty to use S3_ENDPOINT (fine locally and for AWS S3/R2).
S3_PUBLIC_ENDPOINT=
# Path-style URLs (endpoint/bucket/key) are needed for most self-hosted S3 servers.
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=postpin
S3_REGION=eu-west-1

# Storage quotas, e.g. "50 GB" or "1.5 TiB" (KB/MB/GB/TB are decimal, KiB/MiB/GiB/TiB binary).
# Leave empty for no limit. Admins can override both per organization and per user.
STORAGE_DEFAULT_ORG_QUOTA="10 GB"
STORAGE_DEFAULT_USER_QUOTA="5 GB"
# Total storage for the usage chart in the admin area. Set either a fixed size or a path on the
# storage disk (measured with statfs). STORAGE_CAPACITY wins if both are set. Leave both empty
# to hide the chart, e.g. on AWS S3.
STORAGE_CAPACITY="100 GB"
STORAGE_DISK_PATH=
# Largest file a single upload (plugin or web) may have, same format. Empty = only the quotas.
UPLOAD_MAX_FILE_SIZE=

# Redis (used by docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_USE_SSL=false
