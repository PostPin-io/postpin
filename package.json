{
	"name": "@postpin-io/workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"scripts": {
		"sync-env": "node ./scripts/sync-env.mjs",
		"dev": "pnpm run sync-env && pnpm --filter @postpin-io/postpin run generate:api && pnpm --filter @postpin-io/postpin run build:api-client && pnpm -r --parallel --reporter append-only run dev",
		"build": "pnpm -r run build",
		"prepare": "husky",
		"format": "prettier --write . '!packages/**' && pnpm -r run format",
		"lint": "prettier --check . '!packages/**' && pnpm -r run lint",
		"charts": "d2 docs/architecture/architecture.d2 docs/architecture/architecture.svg",
		"charts:watch": "nodemon --watch docs/architecture -e d2 --exec \"pnpm charts\"",
		"setup": "pnpm install && pnpm -r run setup",
		"check": "pnpm -r run check",
		"dev:host": "POSTPIN_HOST=0.0.0.0 pnpm dev",
		"test": "pnpm -r --if-present run test",
		"test:coverage": "pnpm -r --if-present run test:coverage"
	},
	"devDependencies": {
		"@mdi/svg": "^7.4.47",
		"devicon": "^2.18.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.10",
		"simple-icons": "^16.37.0"
	},
	"scarfSettings": {
		"enabled": false
	}
}
