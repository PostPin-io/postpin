{
	"name": "@postpin-io/workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"sync-env": "node ./scripts/sync-env.mjs",
		"dev": "pnpm run sync-env && pnpm -r  --reporter append-only run dev",
		"build": "pnpm -r run build",
		"prepare": "husky",
		"format": "prettier --write . '!packages/**' && pnpm -r run format",
		"lint": "prettier --check . '!packages/**' && pnpm -r run lint"
	},
	"devDependencies": {
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9"
	},
	"scarfSettings": {
		"enabled": false
	}
}
